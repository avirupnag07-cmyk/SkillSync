# =================================================================
# SkillSync Environment Configuration Template
# All keys have functional local defaults. The application works 100%
# without paid API keys via deterministic rule & ontology reasoning!
# =================================================================

# ----------------- Database Configuration (PostgreSQL) -----------------
POSTGRES_USER=skillsync
POSTGRES_PASSWORD=skillsync_secure_password_2026
POSTGRES_DB=skillsync_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://skillsync:skillsync_secure_password_2026@postgres:5432/skillsync_db

# ----------------- Backend Security & API -----------------
SECRET_KEY=skillsync-super-secret-jwt-signing-key-32chars
BACKEND_PORT=8000

# ----------------- LLM Provider Configuration -----------------
# 1. Local Open-Weight Runtime (Ollama - Qwen, Llama 3, Mistral)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 2. Optional Cloud LLM API Keys (Leave blank to use deterministic engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ----------------- Frontend Configuration -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
